# App environment variables
#
# Copy this file to ".env" and fill values.
# Keep "/src/env.js" in sync with this file.

# Required: Clerk — must be the SAME Clerk instance the Gooswing REST API
# validates JWTs against (staging: easy-snapper-18.clerk.accounts.dev).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Optional now, required when server-side Clerk flows are enabled
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Gooswing REST API base URL (defaults to https://web.gooswing.com)
GOOSWING_API_BASE_URL="https://web.gooswing.com"

# Optional
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""
